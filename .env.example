# Copy to .env for local development. Replace placeholders locally; never commit .env.
# Bifrost credentials belong to the gateway and must not be passed to agent containers.
POSTGRES_DB=agentarena
POSTGRES_USER=agentarena
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql://agentarena:change-me-locally@postgres:5432/agentarena

# Set only if required by the selected Bifrost configuration.
BIFROST_API_KEY=
BIFROST_BASE_URL=http://bifrost:8080

API_PORT=8000
PROXY_PORT=8001
LOG_LEVEL=INFO

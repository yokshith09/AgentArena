# Copy to .env for local development (never commit .env). Replace placeholders locally.
# Provider keys are configured inside Bifrost (UI http://localhost:8080), not here,
# and Bifrost credentials must never be passed to agent containers.
POSTGRES_USER=arena
POSTGRES_PASSWORD=arena
POSTGRES_DB=arena
# Host port for the compose Postgres; change (e.g. 5433) if a local Postgres already listens on 5432,
# and use the same port in DATABASE_URL.
POSTGRES_PORT=5432
# Host-side scripts (db/check_db.py); services inside compose use host "postgres" instead of localhost.
DATABASE_URL=postgresql://arena:arena@localhost:5432/arena

BIFROST_PORT=8080
# One-time Bifrost dashboard setup token: choose any long random string locally (never commit it).
BIFROST_SETUP_TOKEN=
BIFROST_BASE_URL=http://bifrost:8080
# Auth the proxy sends TO Bifrost, only if Bifrost has virtual keys/auth enabled. Not a provider key.
BIFROST_API_KEY=
# Provider key, given only to the Bifrost container (see bifrost/config.json). Never commit it.
GROQ_API_KEY=
# Used by scripts/smoke_bifrost.py, set once OQ-05 is answered, e.g. openai/gpt-4o-mini
BIFROST_MODEL=

MOCK_LLM_PORT=9000
API_PORT=8000
# Dashboard origin(s) allowed by the API, comma-separated.
CORS_ORIGINS=http://localhost:5173
PROXY_PORT=8001
# Proxy upstream: Bifrost by default; http://mock_llm:9000/v1 (with --profile mock) for zero-cost runs.
UPSTREAM_BASE_URL=http://bifrost:8080/v1
LOG_LEVEL=INFO
